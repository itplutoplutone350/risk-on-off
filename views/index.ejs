<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Risk On / Risk Off Monitor & Asset Rating</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-900 text-white p-4 sm:p-6 flex flex-col items-center min-h-screen">

    <div class="max-w-4xl w-full space-y-6">
        
        <!-- Intestazione e Pulsanti di Controllo -->
        <div class="bg-gray-800 p-6 rounded-2xl shadow-xl border border-gray-700 text-center space-y-4">
            <h1 class="text-xl sm:text-2xl font-bold">Risk On / Risk Off Monitor & Portafoglio Italia</h1>
            
            <div class="flex flex-wrap justify-center gap-3">
                <button onclick="eseguiAnalisi()" id="btn-analizza" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-5 py-2.5 rounded-xl transition shadow-lg text-sm">
                    Esegui Nuova Analisi
                </button>
                <button onclick="condividiWhatsApp()" class="bg-green-600 hover:bg-green-500 text-white font-semibold px-5 py-2.5 rounded-xl transition shadow-lg text-sm flex items-center gap-2">
                    💬 Condividi su WhatsApp
                </button>
                <button onclick="cancellaStorico()" class="bg-red-600/80 hover:bg-red-600 text-white font-semibold px-4 py-2.5 rounded-xl transition shadow-lg text-sm">
                    🗑️ Cancella Storico
                </button>
            </div>

            <!-- Stato di Caricamento -->
            <div id="loading" class="hidden text-yellow-400 mt-2 animate-pulse text-sm">
                Elaborazione doppia analisi in corso (Macroeconomia, Italia e Titoli)...
            </div>
        </div>

        <!-- Sezione Risultato Corrente Macro -->
        <div class="bg-gray-800 p-6 rounded-2xl shadow-xl border border-gray-700">
            <h2 class="text-lg font-semibold text-gray-300 mb-2">Ultimo Stato Rilevato</h2>
            <p class="text-xl font-bold mb-1">Indice Score: <span id="current-score" class="text-blue-400">-</span> / 90</p>
            <p class="text-sm text-gray-400" id="current-motivation">Nessuna analisi disponibile</p>
        </div>

        <!-- Grafico Storico -->
        <div class="bg-gray-800 p-6 rounded-2xl shadow-xl border border-gray-700">
            <h2 class="text-lg font-semibold text-gray-300 mb-4">Storico Indice Risk</h2>
            <div class="relative h-64 w-full">
                <canvas id="riskChart"></canvas>
            </div>
        </div>

        <!-- Tabella Giudizi Titoli / Asset -->
        <div class="bg-gray-800 p-4 sm:p-6 rounded-2xl shadow-xl border border-gray-700">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-2">
                <h2 class="text-lg font-semibold text-gray-300">Analisi e Indicazioni sui Titoli</h2>
                <span class="text-xs text-gray-400 italic">💡 Tocca una riga per leggere la motivazione su mobile</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-gray-700 text-gray-400 text-xs sm:text-sm">
                            <th class="p-3">Asset / Ticker</th>
                            <th class="p-3 text-center">Giudizio</th>
                            <th class="p-3 hidden sm:table-cell">Motivazione</th>
                        </tr>
                    </thead>
                    <tbody id="titoli-table-body" class="divide-y divide-gray-700 text-xs sm:text-sm">
                        <tr>
                            <td colspan="3" class="p-4 text-center text-gray-500">Nessun dato sui titoli caricato. Clicca su "Esegui Nuova Analisi".</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <script>
        let riskChart;

        function initChart(historyData) {
            const ctx = document.getElementById('riskChart').getContext('2d');
            const labels = historyData.map(item => item.date);
            const scores = historyData.map(item => item.score);

            if (riskChart) {
                riskChart.destroy();
            }

            riskChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Indice Risk-On / Risk-Off',
                        data: scores,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 1,
                            max: 90,
                            grid: { color: '#374151' },
                            ticks: { color: '#9ca3af' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9ca3af', maxTicksLimit: 5 }
                        }
                    },
                    plugins: {
                        legend: { labels: { color: '#ffffff' } }
                    }
                }
            });
        }

        function renderTitoliTable(titoli) {
            const tbody = document.getElementById('titoli-table-body');
            tbody.innerHTML = '';

            if (!titoli || titoli.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" class="p-4 text-center text-gray-500">Nessun dato disponibile.</td></tr>`;
                return;
            }

            titoli.forEach((item) => {
                const trMain = document.createElement('tr');
                trMain.className = "hover:bg-gray-750 transition cursor-pointer sm:cursor-default";

                let badgeColor = "text-white bg-gray-700";
                const actionUpper = (item.action || "").trim().toUpperCase();

                if (actionUpper === "SELL") {
                    badgeColor = "text-red-400 font-bold bg-red-950/40 border border-red-800";
                } else if (actionUpper === "BUY") {
                    badgeColor = "text-green-400 font-bold bg-green-950/40 border border-green-800";
                } else {
                    badgeColor = "text-white font-semibold bg-gray-700/50 border border-gray-600";
                }

                trMain.innerHTML = `
                    <td class="p-3">
                        <div class="font-medium text-white">${item.name}</div>
                        <div class="text-gray-400 font-mono text-[11px]">${item.ticker}</div>
                        <div class="sm:hidden text-gray-300 text-[11px] mt-1 italic mobile-reason hidden">💬 ${item.reason}</div>
                    </td>
                    <td class="p-3 text-center align-middle">
                        <span class="px-2.5 py-1 rounded-full text-xs inline-block ${badgeColor}">
                            ${item.action}
                        </span>
                    </td>
                    <td class="p-3 text-gray-300 hidden sm:table-cell">
                        ${item.reason}
                    </td>
                `;

                trMain.addEventListener('click', () => {
                    if (window.innerWidth < 640) {
                        const reasonDiv = trMain.querySelector('.mobile-reason');
                        reasonDiv.classList.toggle('hidden');
                    }
                });

                tbody.appendChild(trMain);
            });
        }

        function aggiornaInterfaccia(history, ultimiTitoli) {
            if (!history || history.length === 0) {
                document.getElementById('current-score').innerText = '-';
                document.getElementById('current-motivation').innerText = 'Nessuna analisi disponibile';
                renderTitoliTable([]);
                if (riskChart) {
                    riskChart.destroy();
                    riskChart = null;
                }
                return;
            }

            const ultimo = history[history.length - 1];
            document.getElementById('current-score').innerText = ultimo.score;
            document.getElementById('current-motivation').innerText = ultimo.motivation;

            initChart(history);
            if (ultimiTitoli) {
                renderTitoliTable(ultimiTitoli);
            }
        }

        // Funzione per cancellare il localStorage
        function cancellaStorico() {
            if (confirm("Sei sicuro di voler cancellare tutto lo storico salvato nel browser?")) {
                localStorage.removeItem('risk_history');
                aggiornaInterfaccia([], []);
            }
        }

        // Funzione per condividere su WhatsApp
        function condividiWhatsApp() {
            const history = JSON.parse(localStorage.getItem('risk_history')) || [];
            if (history.length === 0) {
                alert("Nessun dato disponibile da condividere. Esegui prima un'analisi!");
                return;
            }

            const ultimo = history[history.length - 1];
            
            // Creazione del testo formattato per WhatsApp
            let testo = `📊 *Risk On / Risk Off Monitor*\n`;
            testo += `📅 Data: ${ultimo.date}\n`;
            testo += `⚡ *Indice Score:* ${ultimo.score} / 90\n\n`;
            testo += `📝 *Sintesi:* ${ultimo.motivation}\n\n`;
            
            if (ultimo.titoli && ultimo.titoli.length > 0) {
                testo += `📌 *Top Segnali Titoli:*\n`;
                // Prende i primi 5 titoli per brevità nel messaggio WhatsApp
                ultimo.titoli.slice(0, 5).forEach(t => {
                    testo += `- ${t.name} (${t.ticker}): *${t.action}*\n`;
                });
            }

            const urlWhatsApp = `https://api.whatsapp.com/send?text=${encodeURIComponent(testo)}`;
            window.open(urlWhatsApp, '_blank');
        }

        async function eseguiAnalisi() {
            const loadingEl = document.getElementById('loading');
            const btnEl = document.getElementById('btn-analizza');
            
            loadingEl.classList.remove('hidden');
            btnEl.disabled = true;
            btnEl.classList.add('opacity-50');

            try {
                const response = await fetch('/api/analyze');
                const result = await response.json();

                if (result.success && result.data) {
                    const nuovoPunto = {
                        date: new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString(),
                        score: result.data.score,
                        motivation: result.data.motivation,
                        titoli: result.data.titoli
                    };

                    let history = JSON.parse(localStorage.getItem('risk_history')) || [];
                    history.push(nuovoPunto);

                    if (history.length > 30) {
                        history = history.slice(-30);
                    }

                    localStorage.setItem('risk_history', JSON.stringify(history));
                    aggiornaInterfaccia(history, result.data.titoli);
                } else {
                    alert('Errore: ' + (result.error || 'Impossibile completare l\'analisi'));
                }
            } catch (err) {
                console.error('Errore di rete:', err);
                alert('Errore di connessione con il server.');
            } finally {
                loadingEl.classList.add('hidden');
                btnEl.disabled = false;
                btnEl.classList.remove('opacity-50');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedHistory = JSON.parse(localStorage.getItem('risk_history')) || [];
            if (savedHistory.length > 0) {
                const ultimoElemento = savedHistory[savedHistory.length - 1];
                aggiornaInterfaccia(savedHistory, ultimoElemento.titoli);
            }
        });
    </script>
</body>
</html>
