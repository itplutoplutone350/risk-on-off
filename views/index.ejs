<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Risk On / Risk Off Monitor</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-900 text-white p-6 flex flex-col items-center justify-center min-h-screen">

    <div class="max-w-2xl w-full bg-gray-800 p-6 rounded-2xl shadow-xl border border-gray-700">
        <h1 class="text-2xl font-bold mb-4 text-center">Risk On / Risk Off Monitor</h1>
        
        <!-- Pulsante di Analisi -->
        <div class="flex justify-center mb-6">
            <button onclick="eseguiAnalisi()" id="btn-analizza" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-6 py-3 rounded-xl transition shadow-lg">
                Esegui Nuova Analisi Ora
            </button>
        </div>

        <!-- Stato di Caricamento -->
        <div id="loading" class="hidden text-center text-yellow-400 mb-4 animate-pulse">
            Analisi in corso su titoli, BTP e mercati globali tramite Gemini...
        </div>

        <!-- Sezione Risultato Corrente -->
        <div class="bg-gray-900 p-4 rounded-xl mb-6 border border-gray-700">
            <h2 class="text-lg font-semibold text-gray-300 mb-2">Ultimo Stato Rilevato</h2>
            <p class="text-xl font-bold mb-1">Indice Score: <span id="current-score" class="text-blue-400">-</span> / 90</p>
            <p class="text-sm text-gray-400" id="current-motivation">Nessuna analisi disponibile</p>
        </div>

        <!-- Grafico Storico -->
        <div class="relative h-64 w-full">
            <canvas id="riskChart"></canvas>
        </div>
    </div>

    <script>
        let riskChart;

        // Inizializzazione del grafico Chart.js
        function initChart(historyData) {
            const ctx = document.getElementById('riskChart').getContext('2d');
            
            const labels = historyData.map(item => item.date);
            const scores = historyData.map(item => item.score);

            if (riskChart) {
                riskChart.destroy();
            }

            riskChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Indice Risk-On / Risk-Off',
                        data: scores,
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 1,
                            max: 90,
                            grid: { color: '#374151' },
                            ticks: { color: '#9ca3af' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9ca3af', maxTicksLimit: 5 }
                        }
                    },
                    plugins: {
                        legend: { labels: { color: '#ffffff' } }
                    }
                }
            });
        }

        // Funzione per aggiornare interfaccia e storico nel localStorage
        function aggiornaInterfaccia(history) {
            if (!history || history.length === 0) return;

            const ultimo = history[history.length - 1];
            document.getElementById('current-score').innerText = ultimo.score;
            document.getElementById('current-motivation').innerText = ultimo.motivation;

            initChart(history);
        }

        // Funzione richiamata dal pulsante
        async function eseguiAnalisi() {
            const loadingEl = document.getElementById('loading');
            const btnEl = document.getElementById('btn-analizza');
            
            loadingEl.classList.remove('hidden');
            btnEl.disabled = true;
            btnEl.classList.add('opacity-50');

            try {
                const response = await fetch('/api/analyze');
                const result = await response.json();

                if (result.success && result.data) {
                    const nuovoPunto = {
                        date: new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString(),
                        score: result.data.score,
                        motivation: result.data.motivation
                    };

                    // Salva nello storico del localStorage del browser
                    let history = JSON.parse(localStorage.getItem('risk_history')) || [];
                    history.push(nuovoPunto);

                    if (history.length > 30) {
                        history = history.slice(-30); // Mantiene gli ultimi 30 punti
                    }

                    localStorage.setItem('risk_history', JSON.stringify(history));
                    aggiornaInterfaccia(history);
                } else {
                    alert('Errore: ' + (result.error || 'Impossibile completare l\'analisi'));
                }
            } catch (err) {
                console.error('Errore di rete:', err);
                alert('Errore di connessione con il server.');
            } finally {
                loadingEl.classList.add('hidden');
                btnEl.disabled = false;
                btnEl.classList.remove('opacity-50');
            }
        }

        // Al caricamento della pagina, carica i dati salvati nel browser
        window.addEventListener('DOMContentLoaded', () => {
            const savedHistory = JSON.parse(localStorage.getItem('risk_history')) || [];
            if (savedHistory.length > 0) {
                aggiornaInterfaccia(savedHistory);
            }
        });
    </script>
</body>
</html>
